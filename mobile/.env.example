# ═══════════════════════════════════════════════════════════════
#  Baseera Flutter — Environment Template
#  Copy this file to `.env` and fill in real values.
#  `.env` is gitignored; this `.env.example` is committed.
# ═══════════════════════════════════════════════════════════════
#
#  Used ONLY by release builds (flutter build apk --release).
#  Debug builds (flutter run) always hit http://10.0.2.2:8000
#  i.e. host machine's localhost via Android emulator.
#
#  Setup:
#    1. Copy this file:   Copy-Item .env.example .env
#    2. Deploy backend to Render / Fly.io / Cloud Run / Railway:
#         - Root directory:   backend
#         - Build cmd:        pip install -r requirements.txt
#         - Start cmd:        uvicorn main:app --host 0.0.0.0 --port $PORT
#         - Env var on host:  GEMINI_API_KEY=<from aistudio.google.com>
#    3. Paste HTTPS URL into BASEERA_API_URL below.
#    4. Build release APK:
#         flutter clean
#         flutter build apk --release
#    5. APK at mobile/build/app/outputs/flutter-apk/app-release.apk
#
#  Free-tier cold-start fix (Render/Fly free plans sleep after 15 min):
#    UptimeRobot monitor pinging BASEERA_API_URL/api/health every 5 min.

BASEERA_API_URL=https://your-deployed-backend.onrender.com
